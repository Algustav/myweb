---
import '@fontsource-variable/noto-sans-sc';
const { title = 'Labs · Al 的实验室', description = '把一些突发奇想，做成能用的小东西。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('labs-theme'); } catch {}
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark'
          ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <header class="topbar"><nav aria-label="实验室导航">
      <a class="brand" href="/labs/">Al <span>/</span> Labs</a>
      <div><a href="/labs/">所有项目</a><a href="/">返回日记本 <span aria-hidden="true">↗</span></a>
        <button class="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换深浅色主题">
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
    </nav></header>
    <main><slot /></main>
    <footer><span>© {new Date().getFullYear()} Al · Labs</span><span>保持好奇，继续折腾。</span></footer>
    <script>
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const preference = matchMedia('(prefers-color-scheme: dark)');
      let manual = false;
      try { manual = ['light', 'dark'].includes(localStorage.getItem('labs-theme') || ''); } catch {}
      const updateLabel = () => {
        const label = root.dataset.theme === 'dark' ? '切换到浅色模式' : '切换到深色模式';
        button?.setAttribute('aria-label', label);
        button?.setAttribute('title', label);
      };
      button?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        manual = true;
        try { localStorage.setItem('labs-theme', root.dataset.theme); } catch {}
        updateLabel();
      });
      preference.addEventListener('change', (event) => {
        if (!manual) { root.dataset.theme = event.matches ? 'dark' : 'light'; updateLabel(); }
      });
      updateLabel();
    </script>
  </body>
</html>
<style is:global>
  * { box-sizing: border-box; }
  html { color-scheme: light; }
  html[data-theme='dark'] { color-scheme: dark; }
  body { margin: 0; min-height: 100vh; color: #243046; background: radial-gradient(ellipse at 9% 0%, #e0eafb 0, transparent 48%), radial-gradient(ellipse at 95% 28%, #eeebfc 0, transparent 42%), #f5f7fb; font-family: 'Noto Sans SC Variable', 'Microsoft YaHei', sans-serif; font-size: 15px; line-height: 1.7; }
  a { color: inherit; }
  a:focus-visible { outline: 3px solid #2563eb; outline-offset: 5px; }
  .topbar { background: #ffffffa6; border-bottom: 1px solid #fff; backdrop-filter: blur(20px); }
  nav { max-width: 1200px; padding: 22px 32px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  nav a { text-decoration: none; }
  nav a:hover { color: #245bca; }
  .brand { font-size: 20px; font-weight: 650; letter-spacing: -.6px; white-space: nowrap; }
  .brand span { margin: 0 9px; color: #9aa7bb; font-weight: 400; }
  nav div { display: flex; align-items: center; gap: 26px; color: #546078; font-size: 14px; }
  .theme-toggle { display: grid; place-items: center; flex-shrink: 0; width: 36px; height: 36px; padding: 0; border: 1px solid #dce6fa; border-radius: 10px; background: #ffffffd9; color: #546078; cursor: pointer; }
  .theme-toggle:hover { color: #285bb9; background: #eef3fd; }
  .theme-toggle:focus-visible { outline: 3px solid #2563eb; outline-offset: 4px; }
  .theme-toggle svg { width: 19px; height: 19px; }
  .theme-toggle .sun { display: none; }
  :root[data-theme='dark'] .theme-toggle .moon { display: none; }
  :root[data-theme='dark'] .theme-toggle .sun { display: block; }
  :root[data-theme='dark'] body { color: #e7edf7; background: radial-gradient(ellipse at 9% 0%, #192c46 0, transparent 48%), radial-gradient(ellipse at 95% 28%, #25243b 0, transparent 42%), #101722; }
  :root[data-theme='dark'] .topbar { background: #182334c9; border-color: #ffffff12; }
  :root[data-theme='dark'] nav div,
  :root[data-theme='dark'] footer,
  :root[data-theme='dark'] .description,
  :root[data-theme='dark'] .card-body p,
  :root[data-theme='dark'] .summary,
  :root[data-theme='dark'] .empty { color: #afbdd1; }
  :root[data-theme='dark'] .eyebrow,
  :root[data-theme='dark'] h2 span,
  :root[data-theme='dark'] .section-heading p { color: #98aac4; }
  :root[data-theme='dark'] h1 span,
  :root[data-theme='dark'] nav a:hover,
  :root[data-theme='dark'] h3 a:hover,
  :root[data-theme='dark'] .back,
  :root[data-theme='dark'] .read-more { color: #91beff; }
  :root[data-theme='dark'] .project-card { background: #1c2737db; border-color: #ffffff14; box-shadow: 0 8px 28px #00000030; }
  :root[data-theme='dark'] .project-card:hover { border-color: #527cb080; box-shadow: 0 16px 42px #00000040; }
  :root[data-theme='dark'] .project-card img { border-color: #ffffff12; }
  :root[data-theme='dark'] .project-card .launch,
  :root[data-theme='dark'] .theme-toggle { background: #273b57; border-color: #3a5375; color: #acd0ff; }
  :root[data-theme='dark'] .project-card .launch:hover,
  :root[data-theme='dark'] .theme-toggle:hover { background: #324d70; color: #d9e9ff; }
  :root[data-theme='dark'] .read-more:hover { color: #c3dcff; }
  :root[data-theme='dark'] .prose a { color: #91beff; }
  :root[data-theme='dark'] a:focus-visible,
  :root[data-theme='dark'] .theme-toggle:focus-visible { outline-color: #91beff; }
  main { max-width: 1200px; margin: auto; padding: 0 32px 80px; min-height: calc(100vh - 166px); }
  footer { max-width: 1200px; margin: auto; padding: 24px 32px; display: flex; justify-content: space-between; gap: 12px; color: #657086; font-size: 12px; }
  @media (max-width: 600px) { nav { padding: 18px 20px; gap: 12px; flex-wrap: wrap; } nav div { gap: 12px; font-size: 12px; margin-left: auto; } main { padding: 0 20px 48px; } footer { padding: 20px; flex-wrap: wrap; } }
</style>
