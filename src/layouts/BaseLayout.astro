---
const {
  title = 'Algustav 的日记本',
  description = '一个安静记录日常与想法的个人日记本。'
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Algustav 的日记本</a>
      <nav aria-label="主导航">
        <a href="/">首页</a>
        <a href="/blog/">文章</a>
        <a href="/about/">关于</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Algustav</span>
      <span>慢慢写，慢慢读。</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --page: #fbfaf7;
    --ink: #292724;
    --muted: #77716a;
    --line: #dfdbd3;
    --reading-width: 680px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--page);
    color: var(--ink);
    font-family: 'Noto Serif SC', 'Songti SC', STSong, SimSun, serif;
    line-height: 1.7;
  }

  a { color: inherit; }

  .site-header,
  .site-footer,
  main {
    width: min(var(--reading-width), calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 30px 0 22px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  nav { display: flex; gap: 16px; color: var(--muted); font-size: 0.9rem; }
  nav a { text-decoration: none; }
  nav a:hover { color: var(--ink); }

  .diary-intro,
  .archive-intro { padding: 68px 0 44px; }

  .kicker {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
  }

  .diary-intro h1,
  .archive-intro h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3rem);
    line-height: 1.2;
    font-weight: 700;
  }

  .diary-intro > p:last-child {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .diary-feed { margin-bottom: 72px; border-top: 1px solid var(--line); }
  .entry { padding: 26px 0 28px; border-bottom: 1px solid var(--line); }
  .entry a { display: block; text-decoration: none; }
  .entry time,
  .reading-header time { color: var(--muted); font-size: 0.88rem; }

  .entry h2 {
    margin: 8px 0 9px;
    font-size: clamp(1.35rem, 4vw, 1.65rem);
    line-height: 1.35;
    font-weight: 700;
  }

  .entry p { margin: 0; color: var(--muted); line-height: 1.7; }
  .entry ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; padding: 0; list-style: none; }
  .entry li { color: var(--muted); font-size: 0.8rem; }
  .entry li::before { content: '#'; }

  .reading-page { max-width: var(--reading-width); margin: 56px auto 88px; }
  .reading-header { margin-bottom: 44px; padding-bottom: 34px; border-bottom: 1px solid var(--line); }

  .reading-page h1 {
    margin: 12px 0 18px;
    font-size: clamp(2rem, 7vw, 3.1rem);
    line-height: 1.25;
    font-weight: 700;
  }

  .article-description { margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.75; }
  .article-content { font-size: 1.125rem; line-height: 1.9; }
  .article-content h2 { margin-top: 2.1em; font-size: 1.55rem; line-height: 1.3; }
  .article-content code { background: #f0eee9; border-radius: 3px; padding: 2px 5px; font-size: 0.9em; }

  .article-content pre {
    overflow-x: auto;
    background: #282623;
    color: #f7f5f0;
    border-radius: 4px;
    padding: 18px 20px;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 28px 0 44px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.84rem;
  }

  @media (max-width: 720px) {
    .site-header { align-items: flex-start; flex-direction: column; }
    .diary-intro, .archive-intro { padding: 46px 0 34px; }
    .reading-page { margin: 40px auto 64px; }
    .article-content { font-size: 19px; line-height: 1.9; }
    .site-footer { align-items: flex-start; flex-direction: column; }
  }
</style>
