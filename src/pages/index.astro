---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePostList from '../components/HomePostList.astro';
import { getCollection } from 'astro:content';
import { getPostDate } from '../lib/postDate';

const posts = (await getCollection('blog')).sort(
  (a, b) => getPostDate(b).valueOf() - getPostDate(a).valueOf()
);
---

<BaseLayout title="Algustav 的日记本">
  <section class="diary-intro">
    <p class="kicker">个人日记</p>
    <h1>Al的记事本</h1>
    <p>记录正在发生的事，也留住那些以后还想重新读到的想法。</p>
  </section>

  <HomePostList posts={posts} />
</BaseLayout>
