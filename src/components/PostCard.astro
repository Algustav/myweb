---
import { render } from 'astro:content';
import { getPostDate } from '../lib/postDate';
import { isLightweightPost } from '../lib/postPresentation';

const { post } = Astro.props;
const postDate = getPostDate(post);
const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(postDate);
const slug = post.id.replace(/\.(md|mdx)$/, '');
const lightweight = isLightweightPost(post);
const { Content } = await render(post);
---

<article class:list={['entry', { 'entry--lightweight': lightweight }]}>
  {lightweight ? (
    <>
      <a class="entry-date" href={`/blog/${slug}/`} aria-label={`打开 ${formattedDate} 的记录`}>
        <time datetime={postDate.toISOString()}>{formattedDate}</time>
      </a>
      <div class="entry-content"><Content /></div>
    </>
  ) : (
    <a href={`/blog/${slug}/`}>
      <time datetime={postDate.toISOString()}>{formattedDate}</time>
      <h2>{post.data.title}</h2>
      <p>{post.data.description}</p>
    </a>
  )}
  {post.data.tags.length > 0 && (
    <ul class="entry-tags">
      {post.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</article>
