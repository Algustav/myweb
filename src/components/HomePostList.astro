---
import type { CollectionEntry } from 'astro:content';
import { getPostCategory, type ContentCategory } from '../lib/contentCategory';
import { getPostDate } from '../lib/postDate';
import { getPostTitle } from '../lib/postPresentation';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const categoryLabels: Record<ContentCategory, string> = {
  blog: '博客',
  moments: '时刻',
  readlater: '文摘',
  pieces: '碎片'
};
const formatDate = (date: Date) => {
  const parts = new Intl.DateTimeFormat('en', {
    timeZone: 'Asia/Hong_Kong',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).formatToParts(date);
  const value = (type: string) => parts.find((part) => part.type === type)?.value;
  return `${value('year')}/${value('month')}/${value('day')}`;
};
---

<section class="archive-list home-post-list" aria-label="文章列表">
  {posts.map((post) => {
    const slug = post.id.replace(/\.(md|mdx)$/, '');
    const date = getPostDate(post);
    const category = getPostCategory(post);
    return (
      <p class="archive-entry home-post-entry">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true"> - </span>
        <span class="archive-entry-content">
          <a class="home-post-link" href={`/blog/${slug}/`}>{getPostTitle(post)}</a>
          <a class="category-pill" href={`/${category}/`}>{categoryLabels[category]}</a>
        </span>
      </p>
    );
  })}
</section>
